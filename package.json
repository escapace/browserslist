{
  "name": "@escapace/browserslist",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/browserslist/issues",
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@escapace/pnpm-pack": "0.6.0",
    "@ls-lint/ls-lint": "2.3.0",
    "@vitest/coverage-v8": "3.1.4",
    "esbuild": "0.25.4",
    "eslint": "9.31.0",
    "eslint-config-escapace": "5.10.0",
    "esroll": "0.4.5",
    "knip": "5.57.1",
    "lefthook": "2.0.13",
    "lightningcss": "1.30.1",
    "prettier": "3.5.3",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.4",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "engines": {
    "pnpm": ">=10.10.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/neutral/index.js"
    }
  },
  "files": [
    "lib/neutral",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/browserslist#readme",
  "license": "MPL-2.0",
  "module": "lib/neutral/index.js",
  "peerDependencies": {
    "browserslist": ">=4.24.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/browserslist",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "lib/types/index.d.ts"
}
