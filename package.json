{
  "name": "@escapace/browserslist",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/browserslist/issues",
  "devDependencies": {
    "@commitlint/cli": "20.3.0",
    "@commitlint/config-conventional": "20.3.0",
    "@escapace/pnpm-pack": "0.6.1",
    "@ls-lint/ls-lint": "2.3.1",
    "@vitest/coverage-v8": "4.0.16",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-config-escapace": "5.10.1",
    "esroll": "1.1.1",
    "knip": "5.79.0",
    "lefthook": "2.0.13",
    "lightningcss": "1.30.2",
    "prettier": "3.7.4",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "engines": {
    "pnpm": ">=10.27.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/neutral/index.js"
    }
  },
  "files": [
    "lib/neutral",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/browserslist#readme",
  "license": "MPL-2.0",
  "module": "lib/neutral/index.js",
  "peerDependencies": {
    "browserslist": ">=4.28.1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/browserslist",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "lib/types/index.d.ts"
}
